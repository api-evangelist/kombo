        "next_cursor",
        "next"
      ],
      "examples": [
        {
          "results": [
            {
              "id": "FFpTK47GhXnU6QAopPq2bdos",
              "key": "tax_id",
              "model": "hris_employees",
              "type": "DEFAULT",
              "label": "Tax ID",
              "is_passthrough_enabled": true,
